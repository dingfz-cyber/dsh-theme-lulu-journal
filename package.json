{
  "name": "dsh-theme-lulu-journal",
  "version": "1.0.0",
  "private": true,
  "description": "噜噜 · 桃粉手账，保留 DSH 原生聊天、历史列表和侧栏拖动。",
  "author": "dingfz-cyber",
  "homepage": "https://github.com/dingfz-cyber/dsh-theme-lulu-journal#readme",
  "repository": { "type": "git", "url": "https://github.com/dingfz-cyber/dsh-theme-lulu-journal.git" },
  "bugs": { "url": "https://github.com/dingfz-cyber/dsh-theme-lulu-journal/issues" },
  "icon": "assets/icon.png",
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/*.png",
    "preview/design-reference.png",
    "locale",
    "src",
    "scripts/build.mjs",
    "scripts/verify.mjs",
    "cordis.patch.yml",
    "README.md",
    "RELEASE_NOTES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "verify": "node scripts/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
